<UserControl x:Class="AIUpdater.Views.ReleaseCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:AIUpdater.Infrastructure"
             xmlns:models="clr-namespace:AIUpdater.Models"
             xmlns:vm="clr-namespace:AIUpdater.ViewModels"
             xmlns:views="clr-namespace:AIUpdater.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate DataType="{x:Type models:ReleaseBadge}">
            <Border CornerRadius="4"
                    Padding="6,1"
                    Margin="0,0,6,2"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="#162E22" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="Available">
                                <Setter Property="Background"
                                        Value="#302712" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="Translated">
                                <Setter Property="Background"
                                        Value="#162A22" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}"
                           FontSize="{Binding FontSize}"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="#7FE2AE" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}"
                                             Value="Available">
                                    <Setter Property="Foreground"
                                            Value="#FCD34D" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}"
                                             Value="Translated">
                                    <Setter Property="Foreground"
                                            Value="#93C5AC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReleaseGroupViewModel}">
            <views:ReleaseGroupView />
        </DataTemplate>
    </UserControl.Resources>
    <Border Tag="{Binding ReleaseKey}"
            Background="#101A14"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush"
                        Value="#283E33" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLatest}"
                                 Value="True">
                        <Setter Property="BorderBrush"
                                Value="#2A523D" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{Binding TitleFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,10,2"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PublishedAt}"
                               FontSize="{Binding MetaFontSize}"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,2"
                               Visibility="{Binding HasPublishedAt, Converter={StaticResource BoolVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Badges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </WrapPanel>
                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <Button Content="Отменить"
                            ToolTip="Остановить обработку этого релиза"
                            Command="{Binding CancelTranslationCommand}"
                            Visibility="{Binding IsTranslating, Converter={StaticResource BoolVisibility}}"
                            MinHeight="24"
                            Padding="8,2"
                            Margin="6,0,0,2"
                            FontSize="{Binding MetaFontSize}" />
                    <Button Content="{Binding ProcessButtonText}"
                            ToolTip="Перевести изменения на русский и составить резюме релиза и блоков через Antigravity Flash"
                            Command="{Binding ProcessCommand}"
                            Visibility="{Binding CanProcess, Converter={StaticResource BoolVisibility}}"
                            MinHeight="24"
                            Padding="8,2"
                            Margin="6,0,0,2"
                            FontSize="{Binding MetaFontSize}" />
                    <Button Content="{Binding CardLanguageButtonText}"
                            ToolTip="Переключить между русским ИИ-обзором и оригиналом для этого релиза"
                            Command="{Binding ToggleCardLanguageCommand}"
                            Visibility="{Binding CanToggleCardLanguage, Converter={StaticResource BoolVisibility}}"
                            MinHeight="24"
                            Padding="8,2"
                            Margin="6,0,0,2"
                            FontSize="{Binding MetaFontSize}" />
                    <Button Content="Обработать заново"
                            ToolTip="Повторно сформировать перевод и резюме этого релиза через Antigravity Flash"
                            Command="{Binding ProcessCommand}"
                            Visibility="{Binding CanReprocess, Converter={StaticResource BoolVisibility}}"
                            MinHeight="24"
                            Padding="8,2"
                            Margin="6,0,0,2"
                            FontSize="{Binding MetaFontSize}" />
                    <Button Content="{Binding ExpandButtonText}"
                            ToolTip="Свернуть или развернуть этот релиз"
                            Command="{Binding ToggleCollapseCommand}"
                            MinHeight="24"
                            Padding="8,2"
                            Margin="6,0,0,2"
                            FontSize="{Binding MetaFontSize}" />
                </WrapPanel>
            </Grid>
            <StackPanel Margin="0,8,0,2"
                        Visibility="{Binding IsTranslating, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding TranslationProgressText}"
                           FontSize="{Binding MetaFontSize}"
                           Foreground="{StaticResource AccentTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5" />
                <ProgressBar Height="2"
                             Background="#16261E"
                             Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0"
                             IsIndeterminate="True" />
            </StackPanel>
            <TextBlock Text="{Binding TranslationErrorText}"
                       FontSize="{Binding MetaFontSize}"
                       Foreground="#F8A5A5"
                       Margin="0,6,0,2"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasTranslationError, Converter={StaticResource BoolVisibility}}" />
            <StackPanel Margin="0,6,0,0"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
                <Border BorderBrush="#2E6248"
                        BorderThickness="2,0,0,0"
                        Padding="10,1,0,1"
                        Margin="0,4,0,6"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolVisibility}}">
                    <infra:FormattedTextBlock FormattedText="{Binding Summary, Mode=OneWay}"
                                              FontSize="{Binding SummaryFontSize, Mode=OneWay}"
                                              Foreground="#C4DECF" />
                </Border>
                <ItemsControl ItemsSource="{Binding Groups}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
