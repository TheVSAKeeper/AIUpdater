<UserControl x:Class="AIUpdater.Views.UpdatesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:AIUpdater.Views" xmlns:infra="clr-namespace:AIUpdater.Infrastructure" FontSize="{DynamicResource Font.Size.Body}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <infra:ToolColumnsConverter x:Key="ToolColumns" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StopButton" Content="Остановить" Command="{Binding StopCommand}" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" />
                <Button x:Name="RunButton" Content="Проверить всё" Command="{Binding CheckAllCommand}" Margin="0,0,8,0" />
                <Button x:Name="UpdateButton" Content="{Binding UpdateButtonText}" Command="{Binding UpdateSelectedCommand}" Style="{DynamicResource Button.Primary}" />
            </StackPanel>
            <TextBlock Text="{Binding OverallStatusText}" Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="StageItemsControl" ItemsSource="{Binding Vendors}" IsEnabled="{Binding CanStartRun}" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="12" Padding="14,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.Size.L}" FontWeight="SemiBold" ToolTip="{Binding Detail}" />
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Margin="0,3,0,0" FontSize="{DynamicResource Font.Size.XS}" Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid>
                                                <UniformGrid.Columns>
                                                    <MultiBinding Converter="{StaticResource ToolColumns}">
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=views:UpdatesView}" />
                                                        <Binding Path="FontSize" RelativeSource="{RelativeSource AncestorType=views:UpdatesView}" />
                                                    </MultiBinding>
                                                </UniformGrid.Columns>
                                            </UniformGrid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
