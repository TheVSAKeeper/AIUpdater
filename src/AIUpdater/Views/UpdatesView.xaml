<UserControl x:Class="AIUpdater.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="{DynamicResource Font.Size.S}">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding CanStartRun, Converter={StaticResource BoolVisibility}}">
                <Button x:Name="RunButton" Content="Проверить всё" Command="{Binding CheckAllCommand}" Margin="0,0,8,0" />
                <Button x:Name="UpdateButton" Content="{Binding UpdateButtonText}" Command="{Binding UpdateSelectedCommand}" Style="{DynamicResource Button.Primary}" />
            </StackPanel>
            <CheckBox x:Name="ActiveOnlyToggle" DockPanel.Dock="Right" Content="Только в работе" IsChecked="{Binding ShowActiveOnly}"
                      Margin="16,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Fg.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding CanStartRun, Converter={StaticResource BoolVisibility}}" />
                <TextBlock x:Name="OperationTitleText" Text="{Binding OperationTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Text}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
        </DockPanel>
        <Border x:Name="OperationPanel" Grid.Row="1" Margin="0,0,0,14"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}">
            <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}" Height="3" MinHeight="0" />
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="14,0,14,10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ComponentsScroll}" Value="Visible">
                                <Setter Property="Margin" Value="14,0,30,10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" /><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Компонент" Foreground="{DynamicResource Fg.Muted}" />
                <TextBlock Grid.Column="2" Text="Установлено" Foreground="{DynamicResource Fg.Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="Установленная версия" />
                <TextBlock Grid.Column="3" Text="Доступно" Foreground="{DynamicResource Fg.Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="Доступная версия" />
                <TextBlock Grid.Column="4" Text="Состояние" Foreground="{DynamicResource Fg.Muted}" />
            </Grid>
            <ScrollViewer x:Name="ComponentsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="StageItemsControl" ItemsSource="{Binding Vendors}" Margin="0,0,0,6">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl"><Style.Triggers>
                                <DataTrigger Binding="{Binding ShowActiveOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers></Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Muted}" Margin="14,0,0,8" />
                                        <Border Background="{DynamicResource Bg.Surface}" CornerRadius="6" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding Cards}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="6" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                            Visibility="{Binding ShowActiveOnly, Converter={StaticResource BoolVisibility}}">
                        <ItemsControl x:Name="RunningItemsControl" ItemsSource="{Binding RunningCards}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
