<UserControl x:Class="AIUpdater.Views.LogPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AIUpdater.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="VendorTabHeaderTemplate"
                      DataType="{x:Type models:VendorStatus}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           Margin="0,0,8,0" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{Binding StatusBrush}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:VendorStatus}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="10,3,10,3"
                           FontSize="{DynamicResource Font.Size.XS}"
                           Foreground="{DynamicResource Fg.Muted}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Detail}"
                           ToolTip="{Binding Detail}"
                           Visibility="{Binding HasActiveDetail, Converter={StaticResource BoolVisibility}}" />
                <TextBox Padding="10,6,10,6"
                         Background="#0C1712"
                         BorderThickness="0"
                         Foreground="#CCE4D6"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="{Binding DataContext.LogFontSize, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AcceptsReturn="True"
                         Text="{Binding Log, Mode=OneWay}"
                         TextChanged="LogTextBox_TextChanged" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid MinHeight="165">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
            <Button x:Name="OpenLogButton"
                    DockPanel.Dock="Right"
                    Content="Открыть лог"
                    Command="{Binding OpenLogCommand}"
                    MinHeight="26"
                    Padding="10,3" />
            <Button x:Name="LogFolderButton"
                    DockPanel.Dock="Right"
                    Content="Папка журналов"
                    Command="{Binding OpenLogFolderCommand}"
                    ToolTip="{Binding LogFolderToolTip}"
                    MinHeight="26"
                    Padding="10,3"
                    Margin="0,0,8,0" />
            <Button x:Name="LogZoomInButton"
                    DockPanel.Dock="Right"
                    Content="A+"
                    Command="{Binding ZoomInLogCommand}"
                    MinHeight="26"
                    Padding="8,3"
                    Margin="0,0,8,0"
                    ToolTip="Увеличить шрифт журнала (Ctrl + Колесо мыши)" />
            <Button x:Name="LogZoomOutButton"
                    DockPanel.Dock="Right"
                    Content="A-"
                    Command="{Binding ZoomOutLogCommand}"
                    MinHeight="26"
                    Padding="8,3"
                    Margin="0,0,6,0"
                    ToolTip="Уменьшить шрифт журнала (Ctrl + Колесо мыши)" />
            <TextBlock Text="Журнал выполнения"
                       FontSize="{DynamicResource Font.Size.Button}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>
        <TabControl x:Name="LogTabs"
                    Grid.Row="1"
                    SelectionChanged="LogTabs_SelectionChanged"
                    PreviewMouseWheel="LogTabs_PreviewMouseWheel">
            <TabItem Header="Общий журнал">
                <TextBox x:Name="LogTextBox"
                         Padding="10,6,10,6"
                         Background="#0C1712"
                         BorderThickness="0"
                         Foreground="#CCE4D6"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="{Binding LogFontSize, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AcceptsReturn="True"
                         Text="{Binding GeneralLogText, Mode=OneWay}"
                         TextChanged="LogTextBox_TextChanged" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
