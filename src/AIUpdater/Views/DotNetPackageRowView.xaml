<UserControl x:Class="AIUpdater.Views.DotNetPackageRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AIUpdater.ViewModels"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </UserControl.Resources>
    <Border x:Name="RowBorder" BorderThickness="3,0,0,0" Padding="10,7" MinHeight="42" ToolTip="{Binding RowToolTip}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Bg.SurfaceAlt}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu x:Name="RowMenu" />
        </Border.ContextMenu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="DotNetActions" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,10,0">
                <TextBlock x:Name="PackageTitleText" Text="{Binding Title}" Foreground="{DynamicResource Fg.Primary}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PackageSubtitleText" Text="{Binding Subtitle}" FontSize="{DynamicResource Font.Size.XS}"
                           Foreground="{DynamicResource Fg.Muted}" Margin="0,2,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
            </StackPanel>
            <TextBlock x:Name="InstalledVersionText" Grid.Column="1" Text="{Binding InstalledText}"
                       Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RowToolTip}" />
            <TextBlock x:Name="AvailableVersionText" Grid.Column="2" Text="{Binding AvailableText}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AvailableText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource State.WarningText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Fg.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.UpToDate}">
                                        <Setter Property="Fill" Value="{DynamicResource State.SuccessText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.UpdateAvailable}">
                                        <Setter Property="Fill" Value="{DynamicResource State.WarningText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.EolInstalled}">
                                        <Setter Property="Fill" Value="{DynamicResource State.WarningText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.ActiveOperation}">
                                        <Setter Property="Fill" Value="{DynamicResource Accent.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.UpToDate}">
                                        <Setter Property="Foreground" Value="{DynamicResource State.SuccessText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.UpdateAvailable}">
                                        <Setter Property="Foreground" Value="{DynamicResource State.WarningText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.EolInstalled}">
                                        <Setter Property="Foreground" Value="{DynamicResource State.WarningText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowState}" Value="{x:Static vm:DotNetPackageRowState.ActiveOperation}">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <TextBlock x:Name="OperationDetailText" Text="{Binding OperationDetail}"
                           Foreground="{DynamicResource Accent.Text}" FontSize="{DynamicResource Font.Size.XS}" Margin="12,2,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding OperationDetail}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OperationDetail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="PrimaryActionButton" Content="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}"
                        Padding="8,3" MinHeight="24" Margin="0,0,6,0" ToolTip="{Binding PrimaryActionToolTip}"
                        Visibility="{Binding HasPrimaryAction, Converter={StaticResource BoolVisibility}}"
                        AutomationProperties.Name="{Binding PrimaryActionToolTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrimaryAccent}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Fg.OnAccent}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="RowMenuButton" MinWidth="28" MinHeight="24" Padding="4" Click="RowMenuButton_Click"
                        Style="{DynamicResource Button.Ghost}" IsEnabled="{Binding CanInteract}"
                        ToolTip="Действия с пакетом .NET" AutomationProperties.Name="{Binding Title, StringFormat=Действия: {0}}">
                    <icons:PackIconLucide Kind="{x:Static icons:PackIconLucideKind.EllipsisVertical}" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
