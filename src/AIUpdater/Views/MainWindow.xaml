<Window x:Class="AIUpdater.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:keepshell="https://schemas.keepshell.dev/wpf"
        xmlns:views="clr-namespace:AIUpdater.Views"
        Title="AI Updater" Icon="/AIUpdater;component/Assets/AIUpdater.ico"
        Width="1200" Height="800" MinWidth="980" MinHeight="600"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource Bg.Base}" Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="{DynamicResource Font.Size.M}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <keepshell:ShellLayout x:Name="Shell" ModalCoversShell="True">
        <keepshell:ShellLayout.TitleBar><views:TitleBarView /></keepshell:ShellLayout.TitleBar>
        <keepshell:ShellLayout.StatusBar><views:StatusBarView /></keepshell:ShellLayout.StatusBar>
        <keepshell:ShellLayout.ContentOverlay><keepshell:ToastHost DataContext="{Binding Toasts}" /></keepshell:ShellLayout.ContentOverlay>
    </keepshell:ShellLayout>
</Window>
