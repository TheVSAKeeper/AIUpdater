<Window x:Class="AIUpdater.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AIUpdater.ViewModels"
        xmlns:views="clr-namespace:AIUpdater.Views"
        Title="AI Updater"
        Icon="/AIUpdater;component/Assets/AIUpdater.ico"
        Width="1120"
        Height="820"
        MinWidth="980"
        MinHeight="700"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate DataType="{x:Type vm:StageCardViewModel}">
            <views:StageCardView />
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="24,16"
          Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.35*" MinHeight="170" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" MinHeight="165" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="/AIUpdater;component/Assets/AIUpdater.png"
                   Width="54"
                   Height="54"
                   Margin="-6,-6,12,-6"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   UseLayoutRounding="True"
                   SnapsToDevicePixels="True" />
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="AI Updater"
                               FontSize="24"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Width="20"
                            Height="20"
                            CornerRadius="10"
                            Background="#162820"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Margin="9,2,0,0"
                            VerticalAlignment="Center"
                            Cursor="Help"
                            ToolTip="Клик по карточке с доступным обновлением отмечает её для общего запуска; клик по остальным карточкам запускает проверку. Меню ⋮ открывает действия с компонентом и историю изменений."
                            ToolTipService.InitialShowDelay="150">
                        <TextBlock Text="?"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="OverallStatusText"
                           Text="{Binding OverallStatusText}"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="StopButton"
                        Content="Остановить"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"
                        Margin="0,0,8,0" />
                <Button Content="Что нового"
                        Command="{Binding OpenChangelogCommand}"
                        Margin="0,0,8,0" />
                <Button x:Name="RunButton"
                        Content="Проверить всё"
                        Command="{Binding CheckAllCommand}"
                        MinWidth="124"
                        Margin="0,0,8,0" />
                <Button x:Name="UpdateButton"
                        Content="{Binding UpdateButtonText}"
                        Command="{Binding UpdateSelectedCommand}"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Foreground="#052417"
                        FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="StageItemsControl"
                          ItemsSource="{Binding Vendors}"
                          IsEnabled="{Binding CanStartRun}"
                          Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,6"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               ToolTip="{Binding Detail}" />
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding StatusBrush}"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <GridSplitter x:Name="LogSplitter"
                      Grid.Row="2"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ShowsPreview="False"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ToolTip="Изменить высоту журнала выполнения" />
        <views:LogPanelView x:Name="LogPanel"
                            Grid.Row="3"
                            DataContext="{Binding LogPanel}" />
        <Grid Grid.Row="4"
              Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="RunProgressBar"
                         Height="3"
                         IsIndeterminate="True"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource BorderBrush}" />
        </Grid>
    </Grid>
</Window>
