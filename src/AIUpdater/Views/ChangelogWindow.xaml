<Window x:Class="AIUpdater.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AIUpdater.Models"
        Title="Что нового – AI Updater"
        Icon="/AIUpdater;component/Assets/AIUpdater.ico"
        Width="1120"
        Height="740"
        MinWidth="860"
        MinHeight="540"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <DataTemplate DataType="{x:Type models:UpdateStage}">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding InstalledVersion}"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20"
          Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Что нового"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="История выпусков кэшируется на диске; кнопка «Обработать этот релиз» формирует краткие резюме и перевод через Antigravity Flash."
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,12,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="LanguageToggleButton"
                        Content="Русский (ИИ)"
                        Click="LanguageToggleButton_Click"
                        MinHeight="30"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        ToolTip="Переключить язык отображения для обработанных выпусков (Русский / Оригинал)" />
                <Button x:Name="RefreshChangelogButton"
                        Content="Проверить новые"
                        Click="RefreshChangelogButton_Click"
                        MinHeight="30"
                        Padding="12,5"
                        Margin="0,0,12,0"
                        ToolTip="Принудительно проверить наличие новых выпусков в источнике" />
                <Button x:Name="ZoomOutButton"
                        Content="A-"
                        Click="ZoomOutButton_Click"
                        MinHeight="30"
                        Padding="9,5"
                        Margin="0,0,4,0"
                        ToolTip="Уменьшить размер текста (Ctrl + Колесо мыши)" />
                <Button x:Name="ZoomResetButton"
                        Content="100%"
                        Click="ZoomResetButton_Click"
                        MinHeight="30"
                        Padding="9,5"
                        Margin="0,0,4,0"
                        ToolTip="Сбросить масштаб текста" />
                <Button x:Name="ZoomInButton"
                        Content="A+"
                        Click="ZoomInButton_Click"
                        MinHeight="30"
                        Padding="9,5"
                        ToolTip="Увеличить размер текста (Ctrl + Колесо мыши)" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="ComponentSearchBox"
                             Padding="9,6"
                             FontSize="12"
                             TextChanged="ComponentSearchBox_TextChanged"
                             ToolTip="Фильтр компонентов по названию или группе" />
                    <TextBlock x:Name="ComponentSearchPlaceholder"
                               Text="Поиск компонента…"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="11,0,8,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
                <CheckBox x:Name="InstalledOnlyCheckBox"
                          Grid.Row="1"
                          Content="Только установленные"
                          FontSize="12"
                          Foreground="{StaticResource MutedBrush}"
                          Margin="2,0,0,8"
                          Checked="InstalledOnlyCheckBox_Changed"
                          Unchecked="InstalledOnlyCheckBox_Changed"
                          ToolTip="Показывать в списке только установленные компоненты" />
                <ListBox x:Name="ComponentList"
                         Grid.Row="2"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource TextBrush}"
                         ScrollViewer.CanContentScroll="False"
                         SelectionChanged="ComponentList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="10,9,8,3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SourceNoteText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="LoadStatusText"
                           Grid.Row="1"
                           Foreground="{StaticResource AccentTextBrush}"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <Border x:Name="TranslationBannerBorder"
                        Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,7"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TranslationBannerTitle"
                                       Text="Обработка выпуска через Antigravity Flash…"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="TranslationBannerDetail"
                                       Text="Составление краткого резюме выпуска, резюме блоков и перевод…"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="CancelTranslationButton"
                                Grid.Column="1"
                                Content="Отменить"
                                Click="CancelTranslationButton_Click"
                                MinHeight="26"
                                Padding="10,3"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center" />
                        <ProgressBar x:Name="TranslationProgressBar"
                                     Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Height="2"
                                     Margin="0,6,0,0"
                                     Background="#16261E"
                                     Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0"
                                     IsIndeterminate="True" />
                    </Grid>
                </Border>
                <Border Grid.Row="3"
                        Background="#0A1410"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <ScrollViewer x:Name="ReleasesScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14">
                            <StackPanel x:Name="ReleaseCardsPanel" />
                        </ScrollViewer>
                        <TextBox x:Name="ChangelogTextBox"
                                 Background="#0C1712"
                                 Foreground="#CCE4D6"
                                 BorderThickness="0"
                                 Padding="16"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Segoe UI"
                                 FontSize="14"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Visibility="Collapsed"
                                 TextChanged="ChangelogTextBox_TextChanged" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button x:Name="SourceButton"
                            Content="Открыть источник"
                            Click="SourceButton_Click"
                            Margin="0,0,10,0" />
                    <Button Content="Закрыть"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
