<Window x:Class="AIUpdater.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AIUpdater.Models"
        xmlns:vm="clr-namespace:AIUpdater.ViewModels"
        xmlns:views="clr-namespace:AIUpdater.Views"
        Title="Что нового – AI Updater"
        Icon="/AIUpdater;component/Assets/AIUpdater.ico"
        Width="1120"
        Height="740"
        MinWidth="860"
        MinHeight="540"
        Background="{DynamicResource Bg.Base}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate DataType="{x:Type models:UpdateStage}">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding InstalledVersion}"
                           FontSize="11"
                           Foreground="{DynamicResource Fg.Muted}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReleaseCardViewModel}">
            <views:ReleaseCardView />
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20"
          Background="{DynamicResource Bg.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Что нового"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Width="20"
                        Height="20"
                        CornerRadius="10"
                        Background="#162820"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        Margin="9,2,0,0"
                        VerticalAlignment="Center"
                        Cursor="Help"
                        ToolTip="{Binding SourceInfoToolTip}"
                        ToolTipService.InitialShowDelay="150">
                    <TextBlock Text="i"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg.Muted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ChannelToggleButton"
                        Content="{Binding ChannelToggleText}"
                        Command="{Binding ToggleChannelCommand}"
                        Visibility="{Binding HasChannelSwitch, Converter={StaticResource BoolVisibility}}"
                        MinHeight="30"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        ToolTip="{Binding ChannelToggleToolTip}" />
                <Button x:Name="LanguageToggleButton"
                        Content="{Binding LanguageToggleText}"
                        Command="{Binding ToggleLanguageCommand}"
                        MinHeight="30"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        ToolTip="Переключить язык отображения для обработанных выпусков (Русский / Оригинал)" />
                <Button x:Name="RefreshChangelogButton"
                        Content="Проверить новые"
                        Command="{Binding RefreshCommand}"
                        MinHeight="30"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        ToolTip="Принудительно проверить наличие новых выпусков в источнике" />
                <Button x:Name="SourceButton"
                        Content="Источник ↗"
                        Command="{Binding OpenSourceCommand}"
                        MinHeight="30"
                        Padding="12,5"
                        Margin="0,0,12,0"
                        ToolTip="{Binding SourceButtonToolTip}" />
                <Button x:Name="ZoomOutButton"
                        Content="A-"
                        Command="{Binding ZoomOutCommand}"
                        MinHeight="30"
                        Padding="9,5"
                        Margin="0,0,4,0"
                        ToolTip="Уменьшить размер текста (Ctrl + Колесо мыши)" />
                <Button x:Name="ZoomResetButton"
                        Content="{Binding ZoomLabel}"
                        Command="{Binding ZoomResetCommand}"
                        MinHeight="30"
                        Padding="9,5"
                        Margin="0,0,4,0"
                        ToolTip="Сбросить масштаб текста" />
                <Button x:Name="ZoomInButton"
                        Content="A+"
                        Command="{Binding ZoomInCommand}"
                        MinHeight="30"
                        Padding="9,5"
                        ToolTip="Увеличить размер текста (Ctrl + Колесо мыши)" />
            </StackPanel>
        </Grid>
        <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Агент перевода" FontSize="11" Foreground="{DynamicResource Fg.Muted}" />
                    <TextBlock Text="{Binding AgentSettings.SavedDescription}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AgentSettings.SavedDescription}" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="TranslationSettingsButton" Grid.Column="1" Content="Настроить…"
                        Click="TranslationSettings_Click" MinHeight="32" Padding="12,5" VerticalAlignment="Center" />
            </Grid>
        </Border>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="ComponentSearchBox"
                             Padding="9,6"
                             FontSize="12"
                             Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр компонентов по названию или группе" />
                    <TextBlock x:Name="ComponentSearchPlaceholder"
                               Text="Поиск компонента…"
                               Foreground="{DynamicResource Fg.Muted}"
                               FontSize="12"
                               Margin="11,0,8,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsSearchPlaceholderVisible, Converter={StaticResource BoolVisibility}}" />
                </Grid>
                <CheckBox x:Name="InstalledOnlyCheckBox"
                          Grid.Row="1"
                          Content="Только установленные"
                          FontSize="12"
                          Foreground="{DynamicResource Fg.Muted}"
                          Margin="2,0,0,8"
                          IsChecked="{Binding InstalledOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Показывать в списке только установленные компоненты" />
                <ListBox x:Name="ComponentList"
                         Grid.Row="2"
                         Background="{DynamicResource Bg.Surface}"
                         BorderBrush="{DynamicResource Border.Default}"
                         Foreground="{DynamicResource Fg.Primary}"
                         ScrollViewer.CanContentScroll="False"
                         ItemsSource="{Binding StagesView}"
                         SelectedItem="{Binding SelectedStage, Mode=TwoWay}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg.Muted}"
                                               Margin="10,9,8,3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LoadStatusText"
                           Text="{Binding LoadStatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource Accent.Text}"
                           Margin="0,0,0,6"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasLoadStatus, Converter={StaticResource BoolVisibility}}" />
                <Border Grid.Row="1"
                        Background="#0A1410"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <ScrollViewer x:Name="ReleasesScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14"
                                      Visibility="{Binding IsCardsVisible, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl x:Name="ReleaseCardsPanel"
                                          ItemsSource="{Binding Releases}" />
                        </ScrollViewer>
                        <TextBox x:Name="ChangelogTextBox"
                                 Background="#0C1712"
                                 Foreground="#CCE4D6"
                                 BorderThickness="0"
                                 Padding="16"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Segoe UI"
                                 FontSize="{Binding BaseFontSize, Mode=OneWay}"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Text="{Binding RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsRawTextVisible, Converter={StaticResource BoolVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
