<UserControl x:Class="AIUpdater.Views.Settings.TranslationSettingsCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ContextMenu x:Key="ModelChoicesMenu" ItemsSource="{Binding Models}">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding}" />
                    <EventSetter Event="Click" Handler="ModelChoice_Click" />
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="0,0,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Агент" Margin="0,0,0,7" />
                    <ComboBox x:Name="TranslationAgentComboBox" ItemsSource="{Binding Backends}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BackendId}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Уровень рассуждения" Margin="0,0,0,7" />
                    <ComboBox x:Name="TranslationEffortComboBox" ItemsSource="{Binding Efforts}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Effort}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Модель" Margin="0,18,0,7" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TranslationModelTextBox" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Name="ModelChoicesButton" Grid.Column="1" Content="Выбрать…" Margin="8,0,0,0" IsEnabled="{Binding HasModels}" Click="ModelChoices_Click" ContextMenu="{StaticResource ModelChoicesMenu}" />
            </Grid>
            <TextBlock Text="Выберите из списка или введите ID. Пусто – модель по умолчанию в CLI." Foreground="{DynamicResource Fg.Muted}" FontSize="{DynamicResource Font.Size.S}" Margin="0,7,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="AutomaticTranslationCheckBox" Content="Переводить новые выпуски автоматически" IsChecked="{Binding Automatic}" Margin="0,22,0,22" />
            <TextBlock Text="Путь к CLI" Margin="0,0,0,7" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TranslationExecutablePathBox" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,8" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Обзор…" Click="BrowseExecutable_Click" Margin="8,0,0,0" Padding="14,8" />
            </Grid>
            <TextBlock Text="Оставьте пустым для автоматического поиска установленного агента." Foreground="{DynamicResource Fg.Muted}" FontSize="{DynamicResource Font.Size.S}" Margin="0,7,0,0" TextWrapping="Wrap" />
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DetectTranslationCliButton" Content="Проверить CLI" Command="{Binding DetectCommand}" MinHeight="34" Padding="12,6" VerticalAlignment="Top" />
                <TextBlock x:Name="TranslationCliStatus" Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding DetectedPath}" Foreground="{DynamicResource Fg.Muted}" Margin="12,2,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отменить изменения" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
            <Button x:Name="SaveTranslationSettingsButton" Content="Применить" Command="{Binding SaveCommand}" Style="{DynamicResource Button.Primary}" />
        </StackPanel>
    </StackPanel>
</UserControl>
