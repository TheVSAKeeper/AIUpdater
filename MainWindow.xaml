<Window x:Class="AIUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Updater"
        Icon="Assets/AIUpdater.ico"
        Width="960"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="AI Updater" />
          <TextBlock x:Name="OverallStatusText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Готов к проверке обновлений" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OpenLogButton" Margin="0,0,8,0" Click="OpenLogButton_Click" Content="Открыть лог" />
          <Button x:Name="StopButton" Margin="0,0,8,0" Click="StopButton_Click" Content="Остановить" IsEnabled="False" />
          <Button x:Name="RunButton" Click="RunButton_Click" Content="Обновить всё" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <ItemsControl x:Name="StageItemsControl" ItemsSource="{Binding Stages}" Margin="24,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0,3,14,3"
                    Padding="8,7"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    HorizontalContentAlignment="Stretch"
                    CommandParameter="{Binding}"
                    Click="StageButton_Click"
                    ToolTip="Обновить только это приложение или компонент">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding IndicatorBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{Binding StatusBrush}" Text="{Binding Status}" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Grid Grid.Row="2" Margin="24,18,24,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Text="Журнал выполнения" />
      <TabControl x:Name="LogTabs" Grid.Row="1">
        <TabItem Header="Общий журнал">
      <Border Background="#171A1F" BorderBrush="#282D35" BorderThickness="1" CornerRadius="4">
        <TextBox x:Name="LogTextBox"
                 Padding="14"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#D8DEE9"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" />
      </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <Grid Grid.Row="3" Margin="24,0,24,16">
      <ProgressBar x:Name="RunProgressBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" />
      <TextBlock x:Name="ScriptPathText" Margin="0,8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Foreground="{StaticResource MutedBrush}" />
    </Grid>
  </Grid>
</Window>
