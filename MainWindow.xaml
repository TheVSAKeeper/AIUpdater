<Window x:Class="AIUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Updater" Icon="Assets/AIUpdater.ico"
        Width="1120" Height="820" MinWidth="980" MinHeight="700"
        FontFamily="Segoe UI" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
  <Grid Margin="24,18" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Source="Assets/AIUpdater.png" Width="72" Height="72" Margin="-8,-8,14,-8"
             RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="AI Updater" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="OverallStatusText" Text="Готов к проверке обновлений" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Что нового" Click="ChangelogButton_Click" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,16,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Проверьте версии и выберите обновления" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
          <TextBlock Text="Карточка с флажком – выбор, меню ⋮ – проверка и действия" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,12,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="StopButton" Content="Остановить" Click="StopButton_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,0,10,0" />
          <Button x:Name="RunButton" Content="Проверить всё" Click="RunButton_Click" MinWidth="130" Margin="0,0,10,0">
          </Button>
          <Button x:Name="UpdateButton" Content="Обновить выбранные (0)" Click="UpdateButton_Click" IsEnabled="False"
                  Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#052417" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>
    <ItemsControl x:Name="StageItemsControl" Grid.Row="2" ItemsSource="{Binding Vendors}" Margin="0,0,0,6">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="14,6" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" ToolTip="{Binding Detail}" />
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Margin="0,3,0,0" FontSize="11" />
              </StackPanel>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Stages}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#182A21" CornerRadius="9" Margin="6,0,0,0" BorderThickness="1" Padding="6">
                          <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                              <MenuItem Header="Проверить" Click="CheckComponent_Click" />
                              <MenuItem Header="Обновить" Click="UpdateComponent_Click" IsEnabled="{Binding CanUpdate}" />
                              <MenuItem Header="Установить" Tag="Install" Click="ComponentAction_Click" IsEnabled="{Binding CanManageInstallation}" />
                              <MenuItem Header="Удалить" Tag="Uninstall" Click="ComponentAction_Click" IsEnabled="{Binding CanManageInstallation}" />
                              <Separator />
                              <MenuItem Header="Что нового" Click="ChangelogMenuItem_Click" />
                            </ContextMenu>
                          </Border.ContextMenu>
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentTextBrush}" /></Trigger>
                            <DataTrigger Binding="{Binding PackageStatus}" Value="NotInstalled"><Setter Property="Opacity" Value="0.7" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Margin="0,0,3,0" MinWidth="28" MinHeight="36" Padding="6" IsChecked="{Binding IsSelectedForUpdate}"
                                  Visibility="{Binding CanSelectForUpdate, Converter={StaticResource BoolVisibility}}" ToolTip="Выбрать для обновления"
                                  AutomationProperties.Name="{Binding Name, StringFormat=Выбрать для обновления: {0}}" />
                        <Button Grid.Column="1" Tag="Stage" Click="StageButton_Click" HorizontalContentAlignment="Stretch" Padding="2" MinHeight="52"
                                Background="Transparent" BorderThickness="0" ToolTip="{Binding ResultDescription}" VerticalContentAlignment="Top"
                                AutomationProperties.Name="{Binding CardActionName}">
                          <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <Grid Margin="0,4,0,0">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="11" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <Ellipse Width="6" Height="6" Fill="{Binding IndicatorBrush}" Margin="0,0,5,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                            </Grid>
                            <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                              <Run Text="{Binding VersionPrefixText, Mode=OneWay}" Foreground="{Binding VersionBrush}" /><Run Text="{Binding VersionTargetText, Mode=OneWay}" Foreground="{Binding VersionTargetBrush}" />
                            </TextBlock>
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Content="⋮" MinHeight="26" Width="22" Padding="0" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0" Click="CardMenuButton_Click" ToolTip="Действия с инструментом"
                                AutomationProperties.Name="{Binding Name, StringFormat=Действия: {0}}">

                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Grid.Row="3" MinHeight="140">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
        <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Content="Открыть лог" Click="OpenLogButton_Click" MinHeight="28" Padding="10,4" />
        <Button x:Name="LogFolderButton" DockPanel.Dock="Right" Content="Папка журналов" Click="LogFolderButton_Click" MinHeight="28" Padding="10,4" Margin="0,0,8,0" />
        <TextBlock Text="Журнал выполнения" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <TabControl x:Name="LogTabs" Grid.Row="1">
        <TabItem Header="Общий журнал">
          <TextBox x:Name="LogTextBox" Padding="12,10,12,14" Background="#0C1712" BorderThickness="0" Foreground="#CCE4D6"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AcceptsReturn="True" />
        </TabItem>
      </TabControl>
    </Grid>
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.RowDefinitions><RowDefinition Height="3" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ProgressBar x:Name="RunProgressBar" Height="3" IsIndeterminate="True" Visibility="Hidden" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" />
    </Grid>
  </Grid>
</Window>
