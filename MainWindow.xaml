<Window x:Class="AIUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Updater" Icon="Assets/AIUpdater.ico"
        Width="1120" Height="820" MinWidth="980" MinHeight="700"
        FontFamily="Segoe UI" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24,18" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Source="Assets/AIUpdater.png" Width="56" Height="56" Margin="-7,0,14,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="AI Updater" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="OverallStatusText" Text="Готов к проверке обновлений" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="2" x:Name="OpenLogButton" Content="Открыть лог" Click="OpenLogButton_Click" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,16,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <CheckBox x:Name="CheckOnlyCheckBox" Content="Только проверить" FontSize="14" FontWeight="SemiBold"
                    IsChecked="True" Checked="CheckMode_Changed" Unchecked="CheckMode_Changed" />
          <TextBlock x:Name="ModeDescriptionText" Text="Сравнить версии без установки обновлений" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="StopButton" Content="Остановить" Click="StopButton_Click" IsEnabled="False" Margin="0,0,10,0" />
          <Button x:Name="RunButton" Content="Проверить всё" Click="RunButton_Click" Background="{StaticResource AccentBrush}"
                  BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" MinWidth="150">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="#052417" />
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#D5E7DC" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="#1D4D37" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <ItemsControl x:Name="StageItemsControl" Grid.Row="2" ItemsSource="{Binding Vendors}" Margin="0,0,0,6">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" ToolTip="{Binding Detail}" />
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Margin="0,3,0,0" FontSize="11" />
              </StackPanel>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Stages}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Tag="Stage" Click="StageButton_Click" HorizontalContentAlignment="Stretch" Padding="9,5" Margin="6,0,0,0"
                            ToolTip="Запустить этот компонент в выбранном режиме" Background="#182A21">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6" Fill="{Binding IndicatorBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                          <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Grid.Row="3" MinHeight="190">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock Text="Журнал выполнения" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
      <TabControl x:Name="LogTabs" Grid.Row="1">
        <TabItem Header="Общий журнал">
          <TextBox x:Name="LogTextBox" Padding="16" Background="#0C1712" BorderThickness="0" Foreground="#CCE4D6"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" />
        </TabItem>
      </TabControl>
    </Grid>
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.RowDefinitions><RowDefinition Height="3" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ProgressBar x:Name="RunProgressBar" Height="3" IsIndeterminate="True" Visibility="Hidden" Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" />
      <TextBlock x:Name="ScriptPathText" Grid.Row="1" Text="Расположение скрипта и журналов" Margin="0,7,0,0"
                 HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedBrush}" />
    </Grid>
  </Grid>
</Window>
