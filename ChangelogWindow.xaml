<Window x:Class="AIUpdater.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Что нового — AI Updater" Icon="Assets/AIUpdater.ico"
        Width="960" Height="680" MinWidth="760" MinHeight="480"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Что нового" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Последние опубликованные изменения. История может включать уже установленную версию." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ListBox x:Name="ComponentList" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
               Foreground="{StaticResource TextBrush}" DisplayMemberPath="Name" SelectionChanged="ComponentList_SelectionChanged" Margin="0,0,16,0">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1C4430" /><Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1C3328" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="SourceNoteText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="LoadStatusText" Grid.Row="1" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="ChangelogTextBox" Grid.Row="2" Background="#0C1712" Foreground="#CCE4D6" BorderBrush="{StaticResource BorderBrush}"
                 Padding="16" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="13" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="SourceButton" Content="Открыть источник" Click="SourceButton_Click" Margin="0,0,10,0" />
          <Button Content="Закрыть" Click="CloseButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
