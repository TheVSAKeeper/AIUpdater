<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AIUpdater.ico</ApplicationIcon>
    <AssemblyName>AIUpdater</AssemblyName>
    <RootNamespace>AIUpdater</RootNamespace>
    <DesktopOutputDirectory>$(USERPROFILE)\Desktop\AIUpdater</DesktopOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AIUpdater.ico" />
    <None Update="Update-Codex.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyBuildToDesktop" AfterTargets="Build">
    <ItemGroup>
      <DesktopBuildFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <MakeDir Directories="$(DesktopOutputDirectory)" />
    <Copy SourceFiles="@(DesktopBuildFiles)"
          DestinationFiles="@(DesktopBuildFiles->'$(DesktopOutputDirectory)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Text="AIUpdater copied to $(DesktopOutputDirectory)" Importance="high" />
  </Target>

</Project>
